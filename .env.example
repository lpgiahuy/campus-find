APP_NAME="CampusFind API"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# Thay user và password bằng thông tin PostgreSQL cục bộ của bạn.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/uit-campus-find

# Khóa ký JWT: thay bằng chuỗi ngẫu nhiên dài, ví dụ tạo bằng
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
